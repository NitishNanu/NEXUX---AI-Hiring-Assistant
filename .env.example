# ===== Azure OpenAI Configuration =====
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-2026-03-05
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# ===== OR Standard OpenAI =====
OPENAI_API_KEY=your-openai-api-key

# ===== OR Google Gemini (FREE — RECOMMENDED) =====
GOOGLE_API_KEY=your-google-api-key

# ===== App Configuration =====
FAISS_INDEX_PATH=./data/faiss_index
UPLOAD_DIR=./data/uploads
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ===== NEW: MongoDB + JWT =====
MONGODB_URL=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/nexus?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-secret-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440